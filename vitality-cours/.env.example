# VITALITY COURS - backend environment template.
# Copy this file to backend/.env and fill in YOUR OWN keys (never someone else's).
# The real .env is git-ignored and must never be committed.

# --- Large language model (the tutor's brain) ---
LLM_PROVIDER=gemini
LLM_API_KEY=

# --- Speech to text: handled on-device by the phone (no key needed) ---

# --- Text to speech: handled on-device by the phone (no key needed) ---

# --- Pronunciation assessment (scores how words are said) ---
PRONUNCIATION_PROVIDER=azure
PRONUNCIATION_API_KEY=
PRONUNCIATION_REGION=

# --- Server ---
PORT=8080
ALLOWED_ORIGIN=app://vitality-cours
